# Banco remoto (Supabase)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=sua-chave-publicavel

# Django (OBRIGATÓRIO em produção)
DJANGO_SECRET_KEY=gere-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=seuusuario.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://seuusuario.pythonanywhere.com

# E-mail real para recuperar senha (ex.: Gmail com senha de app)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seuemail@gmail.com
EMAIL_HOST_PASSWORD=senha-de-app
DEFAULT_FROM_EMAIL=Ronin Cyber Forge <seuemail@gmail.com>
DJANGO_HTTPS=True
